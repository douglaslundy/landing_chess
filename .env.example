# Publica no frontend. Use a Public Key de teste em Development/Preview.
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Segredos de servidor. Nunca use prefixo publico nestas variaveis.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=webhook_secret_from_mercado_pago
MERCADOPAGO_EXPECTED_COLLECTOR_ID=123456789
APP_BASE_URL=https://seu-dominio.vercel.app
DATABASE_URL=postgres://user:password@host:5432/database
DATABASE_SSL=true
PRODUCT_ACCESS_URL=https://url-secreta-ou-area-do-produto.example.com/acesso
CRON_SECRET=troque-por-um-token-longo-e-aleatorio

# SMTP transacional com TLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario
SMTP_PASSWORD=senha
EMAIL_FROM="Xadrez Essencial <vendas@example.com>"
EMAIL_REPLY_TO=suporte@example.com
